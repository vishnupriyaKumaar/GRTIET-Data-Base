# ---------------------------------------------------------------
# Local development: copy this file to ".env" and fill it in.
# On Vercel: add the SAME names under Project -> Settings ->
# Environment Variables (there is no .env file on Vercel).
# ---------------------------------------------------------------

# Password that unlocks ADMIN the FIRST time (before anyone uses
# "Change Password" inside the app). Once the password has been changed
# in the app, the new one is stored (hashed) in the database and this
# value is no longer used.
ADMIN_PASSWORD=grtcse@1234

# Long random string used to sign login cookies. REQUIRED on Vercel.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Firebase / Firestore credentials (ONE of the following):
#
# Option A - Vercel (and any host with no files): paste your whole
# serviceAccountKey.json as ONE line. Easiest way to get that line:
#     npm run firebase-env
FIREBASE_SERVICE_ACCOUNT_JSON=
#
# Option B - your own PC only: leave the line above empty and save your key
# file as backend/serviceAccountKey.json (it is git-ignored).
#
# Option C - no Firebase at all (testing on your PC only): leave everything
# empty; records are kept in backend/data/local-db.json instead.

# Local server port (ignored on Vercel).
PORT=5000
